  "components": [
    {
      "name": "Create article action",
      "kind": "button",
      "refersTo": "create-action",
      "description": "Manager-only entry from the article list.",
      "html": "<a class=\"ds-create\" href=\"#\">Nuevo artículo</a>",
      "css": ".ds-create{display:inline-flex;min-height:44px;align-items:center;gap:8px;padding:0 16px;border-radius:8px;background:var(--color-primary-800,rgb(8,118,50));color:white;font:500 14px/20px Poppins,sans-serif;text-decoration:none}.ds-create:hover{background:var(--color-primary-900,rgb(5,80,35))}.ds-create:focus-visible{outline:2px solid var(--color-primary-800,rgb(8,118,50));outline-offset:2px}.ds-create:active{filter:brightness(.95)}"
    },
    {
      "name": "Publish action",
      "kind": "button",
      "refersTo": "publish-action",
      "description": "Explicit editor publication action.",
      "html": "<button class=\"ds-publish\">Publicar</button>",
      "css": ".ds-publish{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--color-primary-900,rgb(5,80,35));border-radius:9999px;padding:9px 15px;background:var(--color-primary-800,rgb(8,118,50));color:white;font:500 16px/24px Poppins,sans-serif;cursor:pointer}.ds-publish:hover,.ds-publish:active{background:linear-gradient(rgb(255 255 255 / .1),rgb(255 255 255 / .1)),var(--color-primary-800,rgb(8,118,50))}.ds-publish:focus-visible{outline:2px solid var(--color-primary-800,rgb(8,118,50));outline-offset:2px}.ds-publish:disabled{opacity:.5}@media(min-width:640px){.ds-publish{padding-inline:19px;font-size:14px}}"
    },
    {
      "name": "Article filter",
      "kind": "input",
      "description": "Labeled search field in the wrapping list filters.",
      "html": "<label class=\"ds-label\">Buscar<input class=\"ds-filter\" type=\"search\" placeholder=\"Título, resumen o contenido\"></label>",
      "css": ".ds-label{display:block;color:var(--color-neutral-900,rgb(17,24,39));font:500 14px/20px Poppins,sans-serif}.ds-filter{display:block;box-sizing:border-box;width:100%;min-height:44px;margin-top:4px;padding:0 12px;border:1px solid var(--color-neutral-300,rgb(209,213,219));border-radius:8px;background:white;color:var(--color-neutral-900,rgb(17,24,39));font:400 14px/20px Poppins,sans-serif}.ds-filter:focus-visible{outline:2px solid var(--color-primary-800,rgb(8,118,50))}"
    },
    {
      "name": "Editor title field",
      "kind": "input",
      "description": "Shared rounded single-line editor input.",
      "html": "<label class=\"ds-label\">Título<input class=\"ds-editor-input\" type=\"text\" placeholder=\"Título del artículo\"></label>",
      "css": ".ds-label{display:block;color:var(--color-neutral-900,rgb(17,24,39));font:500 14px/20px Poppins,sans-serif}.ds-editor-input{display:block;box-sizing:border-box;width:100%;height:44px;margin-top:4px;padding:12px 16px;border:1px solid var(--color-neutral-200,rgb(229,231,235));border-radius:16px;background:white;color:var(--color-neutral-900,rgb(17,24,39));font:400 14px/20px Poppins,sans-serif}.ds-editor-input:focus{outline:none;border-color:rgb(190,228,205);box-shadow:0 0 0 3px rgb(213 239 222 / .5)}"
    },
    {
      "name": "Article card",
      "kind": "card",
      "refersTo": "article-card",
      "description": "Cover-led linked preview with a compact metadata footer.",
      "html": "<a class=\"ds-card\" href=\"#\"><div class=\"ds-cover\">Imagen principal</div><div class=\"ds-card-body\"><h3>Artículo de la comunidad</h3><p>Una línea que da contexto</p><footer>Autor · 1 may 2026 · 1 min</footer></div></a>",
      "css": ".ds-card{display:block;overflow:hidden;border:1px solid var(--color-neutral-200,rgb(229,231,235));border-radius:12px;background:white;color:var(--color-neutral-900,rgb(17,24,39));font-family:Poppins,sans-serif;text-decoration:none;transition:border-color .2s}.ds-card:hover{border-color:rgb(22,164,76)}.ds-card:focus-visible{outline:2px solid var(--color-primary-800,rgb(8,118,50));outline-offset:2px}.ds-cover{display:flex;aspect-ratio:16/10;align-items:center;justify-content:center;background:var(--color-secondary-100,rgb(255,237,197));color:var(--color-primary-800,rgb(8,118,50));font-size:12px}.ds-card-body{padding:16px}.ds-card h3{margin:0;font-size:18px;font-weight:600;line-height:1.375}.ds-card p{margin:8px 0;color:var(--color-neutral-600,rgb(75,85,99));font-size:14px}.ds-card footer{border-top:1px solid var(--color-neutral-200,rgb(229,231,235));padding-top:12px;color:var(--color-neutral-600,rgb(75,85,99));font-size:12px}"
    },
