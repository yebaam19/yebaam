      "css": ".ds-breadcrumb{display:flex;min-width:0;align-items:center;gap:8px;padding:16px 0;color:var(--color-neutral-600,rgb(75,85,99));font:400 14px/20px Poppins,sans-serif}.ds-breadcrumb a{overflow:hidden;color:var(--color-primary-800,rgb(8,118,50));font-weight:600;text-overflow:ellipsis;white-space:nowrap;text-decoration:none}.ds-breadcrumb a:hover{text-decoration:underline}.ds-breadcrumb a:focus-visible{outline:2px solid var(--color-primary-800,rgb(8,118,50))}"
