  "narrative": {
    "overview": "This scoped record covers the article list, editor, and reader even though it lives beside the composer implementation. The shipped surface uses YEBAAM's Poppins, green actions, restrained gold private state, white content surfaces, and compact responsive spacing. It inherits the community shell; it introduces no separate visual identity.",
    "keyCharacteristics": [
      "Compact article work within the existing community shell.",
      "Explicit draft and publication actions.",
      "A cover-led list and readable article detail."
    ],
    "rules": [
      {
        "name": "The Textual State Rule",
        "body": "Published and private draft states keep explicit words; color only reinforces them.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** keep the article list, editor, and reader in the compact YEBAAM community shell.",
      "**Do** keep private draft and published state explicit, with green actions and restrained gold private markers.",
      "**Do** let actions, filters, metadata, and fields wrap naturally at narrow widths."
    ],
    "donts": [
      "**Don't** let a profile hero displace the article task on article routes.",
      "**Don't** claim selected media or playback was visually verified by the six first-view captures."
    ]
  }
