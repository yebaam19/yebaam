# ================================
# Backend URLs
# ================================
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional: same as API in most setups (exposed for Amplify/Terraform; not read in src/)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql

# Optional: used by src/config/featureFlags.ts (environment detection / getEnvironmentInfo)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL_DEV=http://localhost:3000
NEXT_PUBLIC_API_URL_DEV=http://localhost:3001

# ================================
# WebSockets / Real-time
# ================================
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ================================
# AWS S3
# ================================
NEXT_PUBLIC_S3_BUCKET=your-s3-bucket-name
NEXT_PUBLIC_AWS_REGION=us-east-1

# ================================
# Cloudinary
# ================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ================================
# Environment
# ================================
# Any label you use for deploys; only "qa" is special-cased in dev-users-helper.tsx
# (CI often uses "develop", not "development")
NEXT_PUBLIC_ENV=development
