# ================================
# InsForge (backend)
# ================================
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key
# Server-only admin key — used by route handlers for writes that bypass RLS.
# Never expose via NEXT_PUBLIC_*.
INSFORGE_API_KEY=your-insforge-api-key

# ================================
# Legacy backend URLs (being removed — InsForge replaces these)
# ================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql

# Optional: used by src/config/featureFlags.ts (environment detection / getEnvironmentInfo)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL_DEV=http://localhost:3000
NEXT_PUBLIC_API_URL_DEV=http://localhost:3001

# ================================
# WebSockets / Real-time
# ================================
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ================================
# AWS S3
# ================================
NEXT_PUBLIC_S3_BUCKET=your-s3-bucket-name
NEXT_PUBLIC_AWS_REGION=us-east-1

# ================================
# Cloudinary (legacy, being removed)
# ================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ================================
# Cloudflare Images + Stream (user-media hosting)
# ================================
# Server-only — API token with scopes: Images:Edit, Stream:Edit
CLOUDFLARE_ACCOUNT_ID=your-cf-account-id
CLOUDFLARE_API_TOKEN=your-cf-api-token
# Configured in the Cloudflare dashboard when creating the Stream webhook
CLOUDFLARE_STREAM_WEBHOOK_SECRET=your-cf-stream-webhook-secret
# Public — found under Images > Transformations > "Your Cloudflare Images URL"
# e.g. https://imagedelivery.net/<ACCOUNT_HASH>/<image-id>/public
NEXT_PUBLIC_CLOUDFLARE_ACCOUNT_HASH=your-cf-account-hash
# Public — "Customer Code" from Stream dashboard, used in customer-<CODE>.cloudflarestream.com
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=your-cf-stream-customer-code

# ================================
# Email (Resend) — server-side only; not prefixed with NEXT_PUBLIC_
# ================================
RESEND_API_KEY=re_your_resend_api_key
# Must be on a verified Resend domain (e.g. Yebaam <noreply@yebaam.com>)
RESEND_FROM_EMAIL=Yebaam <noreply@yebaam.com>

# ================================
# Node (local dev / build OOM)
# ================================
# If `pnpm dev` or `pnpm build` crashes with V8 out-of-memory, raise the heap (optional; scripts already set 8192 MB):
# NODE_OPTIONS=--max-old-space-size=8192

# ================================
# Environment
# ================================
# Any label you use for deploys; only "qa" is special-cased in dev-users-helper.tsx
# (CI often uses "develop", not "development")
NEXT_PUBLIC_ENV=development
