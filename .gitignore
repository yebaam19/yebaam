# InsForge & AI agent skills
.insforge
.agent
.agents
.augment
# .claude is ignored EXCEPT the governance subagents (.claude/agents/), which are tracked.
# Use .claude/* (ignore children) so the agents/ negation below can take effect — a bare
# `.claude` would exclude the parent dir and make the negation a no-op.
.claude/*
!.claude/agents/
!.claude/agents/**
.cline
.github/copilot*
.kilocode
.qoder
.qwen
.roo
.trae
.windsurf

