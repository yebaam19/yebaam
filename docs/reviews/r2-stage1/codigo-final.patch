+  cleanup();
+  vi.restoreAllMocks();
+});
+
+describe('music audio session lifecycle', () => {
+  it('waits for the initial auth result and permits public anonymous playback', async () => {
+    const { result } = renderHook(useMusicAudioSession);
+    expect(result.current).toBe(false);
